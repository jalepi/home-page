---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Selected projects and work.">
  <h1 class="mb-8 text-3xl font-bold">Projects</h1>

  {projects.length === 0 ? (
    <p>Nothing here yet.</p>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <li class="card overflow-hidden border border-base-300 bg-base-100">
          {project.data.cover && (
            <a
              href={`/projects/${project.id}/`}
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={project.data.cover.src}
                alt=""
                widths={[440, 880]}
                sizes="(min-width: 640px) 440px, 100vw"
                class="aspect-[16/10] w-full border-b border-base-300 bg-base-200 object-contain"
              />
            </a>
          )}
          <div class="card-body">
            <h2 class="card-title">
              <a class="link link-hover" href={`/projects/${project.id}/`}>
                {project.data.title}
              </a>
            </h2>
            <p>{project.data.description}</p>
            {project.data.tags.length > 0 && (
              <div class="card-actions">
                {project.data.tags.map((tag) => (
                  <span class="badge badge-outline">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
