---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
---

<BaseLayout title="Contact" description="How to get in touch.">
  <article class="prose max-w-none">
    <h1>Contact</h1>
    <p>
      The best way to reach me is through
      <a href={site.links.linkedin} rel="me noopener">
        LinkedIn
      </a>
      .
    </p>
    <p>
      You can also find my code on
      <a href={site.links.github} rel="me noopener">
        GitHub
      </a>
      .
    </p>
  </article>
</BaseLayout>
