---
import { site } from "../site";
import BaseLayout from "./BaseLayout.astro";

// Layout for the home page (`src/pages/index.md`).
interface Props {
  frontmatter: {
    greeting: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout description={frontmatter.description}>
  <section class="mb-10">
    <p class="text-base-content/70">{frontmatter.greeting}</p>
    <h1 class="text-4xl font-bold sm:text-5xl">{site.name}</h1>
    <p class="mt-2 text-xl text-base-content/80">{site.title}</p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/projects/">
        See my work
      </a>
      <a class="btn btn-outline" href={site.links.linkedin} rel="me noopener">
        LinkedIn
      </a>
    </div>
  </section>

  <article class="prose max-w-none">
    <slot />
  </article>
</BaseLayout>
